{
  "name": "what-fw",
  "private": true,
  "version": "0.13.10",
  "type": "module",
  "description": "The web framework built for AI agents",
  "workspaces": [
    "packages/*",
    "benchmark"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/CelsianJs/what-framework"
  },
  "homepage": "https://whatfw.com",
  "keywords": [
    "framework",
    "signals",
    "islands",
    "ssr",
    "vanilla-js",
    "reactive"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "bench": "node benchmark/run.js",
    "bench:core": "node benchmark/run.js",
    "bench:dx": "node benchmark/dx-microbench.js",
    "bench:dom": "node benchmark/dom-gate.mjs --out benchmark/baseline/dom.json --rounds 63",
    "bench:gate": "node benchmark/check-regressions.js",
    "bench:update": "node scripts/update-benchmarks.mjs",
    "check:size": "node scripts/check-size.mjs",
    "deploy:vercel": "node scripts/deploy-vercel.mjs",
    "lint": "eslint .",
    "hygiene:publish": "node scripts/check-publish-surface.mjs",
    "hygiene:types": "node scripts/check-type-parity.mjs",
    "check:error-codes": "node scripts/check-error-codes.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:src": "tsc -p tsconfig.src.json",
    "version:bump": "node scripts/bump-version.mjs",
    "release:publish": "node scripts/publish-packages.mjs",
    "verify:registry": "node scripts/verify-registry-install.mjs",
    "release:verify": "node scripts/release/correctness-gates.mjs --with-bench",
    "release:verify:correctness": "node scripts/release/correctness-gates.mjs",
    "release:patch": "node scripts/bump-version.mjs patch && npm run -s release:verify && npm run -s release:publish",
    "release:minor": "node scripts/bump-version.mjs minor && npm run -s release:verify && npm run -s release:publish",
    "release:major": "node scripts/bump-version.mjs major && npm run -s release:verify && npm run -s release:publish",
    "test": "node scripts/run-all-tests.mjs && npm run -s test:stress",
    "test:stress": "node --test stress-tests/*.js",
    "test:prod": "node --conditions=production scripts/check-prod-build.mjs",
    "smoke:scaffold": "node scripts/smoke-scaffold.mjs",
    "smoke:apps": "node smoke/run.mjs",
    "smoke:apps:npm": "node smoke/run.mjs --source=npm",
    "smoke:clean": "node smoke/clean.mjs --kill",
    "smoke:ports": "node smoke/clean.mjs",
    "docs:errors": "node scripts/generate-error-docs.mjs",
    "check:error-docs": "node scripts/generate-error-docs.mjs --check",
    "bench:record": "node benchmark/check-regressions.js --record"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "undici": "^7.28.0",
    "hono": "^4.12.25",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "proxy-addr": "^2.0.8",
    "source-map-js": "^1.2.2"
  }
}
