{
  "name": "what-devtools-mcp",
  "version": "0.13.5",
  "description": "MCP server bridging AI agents to live What Framework app state via WebSocket",
  "type": "module",
  "bin": {
    "what-devtools-mcp": "./src/index.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": {
      "types": "./src/client.d.ts",
      "default": "./src/client.js"
    },
    "./vite": {
      "types": "./src/vite-plugin.d.ts",
      "default": "./src/vite-plugin.js"
    },
    "./vite-plugin": {
      "types": "./src/vite-plugin.d.ts",
      "default": "./src/vite-plugin.js"
    }
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "what-devtools": ">=0.7.0"
  },
  "keywords": [
    "what-framework",
    "devtools",
    "mcp",
    "model-context-protocol",
    "ai-debugging"
  ],
  "author": "ZVN DEV (https://zvndev.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CelsianJs/what-framework"
  },
  "bugs": {
    "url": "https://github.com/CelsianJs/what-framework/issues"
  },
  "homepage": "https://whatfw.com",
  "peerDependenciesMeta": {
    "what-devtools": {
      "optional": true
    }
  }
}
