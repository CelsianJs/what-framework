{
  "name": "what-core",
  "version": "0.14.0",
  "description": "What Framework - Signal-based UI framework built for AI agents",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "production": "./dist/index.min.js",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./jsx-runtime": {
      "types": "./jsx-runtime.d.ts",
      "production": "./dist/jsx-runtime.min.js",
      "import": "./src/jsx-runtime.js",
      "default": "./src/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./jsx-dev-runtime.d.ts",
      "production": "./dist/jsx-dev-runtime.min.js",
      "import": "./src/jsx-dev-runtime.js",
      "default": "./src/jsx-dev-runtime.js"
    },
    "./render": {
      "types": "./render.d.ts",
      "production": "./dist/render.min.js",
      "import": "./src/render.js",
      "default": "./src/render.js"
    },
    "./a11y": {
      "types": "./a11y.d.ts",
      "production": "./dist/entries/a11y.min.js",
      "import": "./src/entries/a11y.js",
      "default": "./src/entries/a11y.js"
    },
    "./ui": {
      "types": "./ui.d.ts",
      "production": "./dist/entries/ui.min.js",
      "import": "./src/entries/ui.js",
      "default": "./src/entries/ui.js"
    },
    "./motion": {
      "types": "./motion.d.ts",
      "production": "./dist/entries/motion.min.js",
      "import": "./src/entries/motion.js",
      "default": "./src/entries/motion.js"
    },
    "./dom": {
      "types": "./dom.d.ts",
      "production": "./dist/entries/dom.min.js",
      "import": "./src/entries/dom.js",
      "default": "./src/entries/dom.js"
    },
    "./form": {
      "types": "./form.d.ts",
      "production": "./dist/entries/form.min.js",
      "import": "./src/entries/form.js",
      "default": "./src/entries/form.js"
    },
    "./data": {
      "types": "./data.d.ts",
      "production": "./dist/entries/data.min.js",
      "import": "./src/entries/data.js",
      "default": "./src/entries/data.js"
    },
    "./testing": {
      "types": "./testing.d.ts",
      "production": "./dist/testing.min.js",
      "import": "./src/testing.js",
      "default": "./src/testing.js"
    },
    "./internal": {
      "types": "./internal.d.ts",
      "production": "./dist/entries/internal.min.js",
      "import": "./src/entries/internal.js",
      "default": "./src/entries/internal.js"
    },
    "./internal/markup-rules": {
      "types": "./markup-rules.d.ts",
      "production": "./dist/markup-rules.min.js",
      "import": "./src/markup-rules.js",
      "default": "./src/markup-rules.js"
    }
  },
  "files": [
    "src",
    "dist/**/*.min.js",
    "index.d.ts",
    "jsx-runtime.d.ts",
    "jsx-dev-runtime.d.ts",
    "render.d.ts",
    "a11y.d.ts",
    "ui.d.ts",
    "motion.d.ts",
    "dom.d.ts",
    "form.d.ts",
    "data.d.ts",
    "internal.d.ts",
    "markup-rules.d.ts",
    "testing.d.ts"
  ],
  "sideEffects": false,
  "keywords": [
    "framework",
    "signals",
    "reactive",
    "islands",
    "ssr",
    "vanilla-js",
    "lightweight",
    "fine-grained"
  ],
  "author": "ZVN DEV (https://zvndev.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CelsianJs/what-framework"
  },
  "bugs": {
    "url": "https://github.com/CelsianJs/what-framework/issues"
  },
  "homepage": "https://whatfw.com"
}
