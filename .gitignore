.env
.env.*

# OS
.DS_Store
*.log

# IDE / tool config (local)
.claude/
.cursor/
.vercel
.playwright-mcp/

# Internal dev docs (not public)
.internal/

# Screenshots / debug artifacts
*.png
*.jpeg
