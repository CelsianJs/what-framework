artifacts/

# Benchmark artifacts (generated apps, DB, results)
benchmark/apps/
benchmark/results/

# Lockfiles: ignore everywhere except the repo root and the krausest benchmark.
# krausest is exempt because its CI job runs `npm ci --prefix benchmark/krausest`,
# and `npm ci` hard-fails without a lockfile. While the file was ignored, the job
# passed locally (where the untracked lockfile exists) and failed on every clean
# checkout. Tracking it also makes the cross-framework benchmark reproducible,
# which matters more here than anywhere else in the repo: the whole point of that
# fixture is comparing pinned competitor versions.
**/package-lock.json
!/package-lock.json
!/benchmark/krausest/package-lock.json

.npmrc

# Scratch Vite projects created by the devtools-mcp prod-build regression test
# (normally removed in its after() hook; ignored here in case a run crashes).
packages/devtools-mcp/test/.tmp-build-*

# Scratch tsc probe dirs used by declaration-shape tests under TypeScript 7
# (the JS createProgram API is gone; probes are written next to the test and
# compiled with tsc, then removed in a finally).
**/.what-tsc-*
